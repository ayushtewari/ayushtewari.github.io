<!DOCTYPE html>
<html data-theme="dark">
  <head>
    <title>{% block title %}{% endblock %}</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tufte-css/1.8.0/tufte.css"/> #}
    <link rel="stylesheet" href="{{ '/assets/tufte/tufte.min.css' | url }}"/>
    <script>
        (function(){
        try {
            var t = localStorage.getItem('theme') ||
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.dataset.theme = t; // or document.body if that’s what your CSS targets
        } catch(e){}
        })();
    </script>
    <style>
      html {
        font-size: 81%; /* 90% of the previous type scale */
        --bg: #101010;
        --text: #bdbdbd;
        --heading-color: #d4d4d4;
        --link-color: #bdbdbd;
        --link-underline: #707070;
        --thumb-border: #707070;
        --thumb-background: #d0d0d0;
      }
      html[data-theme="light"] {
        --bg: #fafafa;
        --text: #414141;
        --heading-color: #303030;
        --link-color: #414141;
        --link-underline: #929292;
        --thumb-border: #d0d0d0;
        --thumb-background: #ffffff;
      }
      /* --- Base Layout & Tufte CSS Overrides --- */
      .marginnote img {
          width: 100%;
}
      .marginnote {
        margin-right: 25%;
        width: 15%;
        box-sizing: border-box;
      }
      .profile-header {
        display: flex;
        align-items: center;
        gap: 4rem;
        width: 100%;
        margin: 2rem 0 0.25rem;
        padding-bottom: 0;
      }
      .profile-header .profile-photo {
        flex: 0 0 30%;
        width: 30%;
        max-width: none;
        margin: 0;
      }
      .profile-header .profile-photo img {
        display: block;
        width: 100%;
        height: auto;
      }
      .profile-summary {
        flex: 1;
        min-width: 0;
      }
      .profile-summary h1 {
        margin-top: 0;
      }
      .profile-summary .subtitle {
        font-size: 1.5rem;
      }
      .profile-role,
      .profile-summary .subtitle,
      .profile-links {
        width: auto;
      }
      .profile-links {
        margin-bottom: 0;
      }
      .profile-role {
        font-size: 1.4rem;
        line-height: 1.5;
      }
      .intro-copy {
        width: 100%;
        max-width: 130ch;
      }
      .intro-copy p {
        margin-top: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .intro-section {
        padding-top: 0;
        padding-bottom: 0.25rem;
      }
      .intro-section h2 {
        margin-top: 0;
      }
      figure.marginnote img,
      figure.publication-thumb img,
      figure.profile-photo img {
        /* Try a smaller value here for a more subtle effect */
        --fade-size: 1%;
        /* The rest of the code remains the same */
        -webkit-mask-image: 
            linear-gradient(to right, transparent, black var(--fade-size), black calc(0% - var(--fade-size)), transparent),
            linear-gradient(to bottom, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent);
            -webkit-mask-composite: source-in;
        
        mask-image: 
            linear-gradient(to right, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent),
            linear-gradient(to bottom, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent);
            mask-composite: intersect;
       }
      #talks {
        margin-top: 2rem;
      }
      #publications .publication-entry {
        display: grid;
        grid-template-columns: 15% minmax(0, 1fr);
        align-items: center;
        gap: 1.5rem;
        padding: 0.85rem 0;
      }
      #publications .publication-entry:first-of-type {
        padding-top: 0;
      }
      #publications .publication-thumb {
        width: 100%;
        max-width: none;
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--thumb-border);
        border-radius: 3px;
        background: var(--thumb-background);
        box-sizing: border-box;
      }
      #publications .publication-thumb img,
      #publications .publication-thumb video {
        display: block;
        width: 100%;
        height: auto;
      }
      .pub-details {
        flex: 1;
        max-width: 125ch;
      }
      #publications .pub-details {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      #publications .pub-title {
        margin: 0 0 0.35rem;
        padding: 0;
        border: 0;
        font-size: 1.5rem;
        font-style: normal;
        font-weight: 700;
        line-height: 1.25;
      }
      #publications .pub-authors,
      #publications .pub-venue {
        width: 100%;
        padding: 0;
        font-size: 1.22rem;
        line-height: 1.4;
      }
      #publications .pub-authors {
        margin: 0 0 0.15rem;
        font-size: 1.32rem;
      }
      #publications .pub-authors .self-author {
        font-weight: 700;
        color: var(--heading-color);
      }
      /* Calmer author lists: underline only on hover/focus */
      #publications .pub-authors a {
        text-decoration-color: transparent;
      }
      #publications .pub-authors a[href]:hover,
      #publications .pub-authors a[href]:focus-visible {
        text-decoration-color: currentColor;
      }
      .site-footer {
        margin: 3rem 0 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--link-underline);
        font-size: 1.05rem;
        opacity: 0.75;
      }
      .back-link {
        margin: 0 0 1.5rem;
        font-size: 1.2rem;
      }
      .site-footer p {
        margin: 0;
        width: auto;
        font-size: 1rem;
        line-height: 1.4;
      }
      #publications .pub-venue {
        margin: 0 0 0.45rem;
        opacity: 1;
      }
      #publications .pub-venue font[color="red"] {
        color: var(--heading-color);
        font-weight: 700;
      }
      #publications .pub-links {
        font-size: 1.26rem;
        line-height: 1.4;
      }
      #publications .pub-links a {
        display: inline-block;
      }

      .phd-info {
        flex: 1;
        /* Allows the text block to fill the available space */
        max-width: 125ch;
        margin-left: 5%;
        margin-right: 0%;
        box-sizing: border-box;
        padding: 0 1rem;
     }
     .phd-link {
        // font-size: 1.2em;
        /* Change this value as needed */
        border-bottom: none;
        padding-bottom: 2px;
     }
    body {
        color: var(--text);
        background-color: var(--bg);
        max-width: 180ch;
    }

    .background-link {
        color: var(--link-color);
    }

      h1, h2, h3 {
        color: var(--heading-color);
    }
      hr, blockquote {
        border-color: #444;
    }

      #group {
        margin-top: 0.75rem;
        padding-top: 0.25rem;
    }
      #group h2 {
        margin-top: 1rem;
    }
      #publications {
        margin-top: 1.5rem;
        padding-top: 0.25rem;
    }
      #publications h2 {
        margin-top: 1rem;
    }

    .group-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, 120px);
        column-gap: 2rem;
        row-gap: 1.25rem;
        justify-content: start;
    }
    #group .student-entry {
        width: 122px;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* This left-aligns the content */
        gap: 2px;
    }
    #group .student-entry figure {
        width: 108px;
        max-width: none;
    }
    .student-role {
        display: block;
        margin-top: 0.1rem;
        font-size: 1.15rem;
        font-style: normal;
        line-height: 1.2;
    }
    /* This rule ensures the photo is not distorted */
    .student-photo {
        height: 126px;
        width: 108px;
        object-fit: cover;
    /* Add the fade effect here */
    --fade-size: 2%; /* You can adjust this value, e.g., 2% for a stronger fade */
    -webkit-mask-image: 
        linear-gradient(to right, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent),
        linear-gradient(to bottom, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent);
    -webkit-mask-composite: source-in; /* For Safari */
    
    mask-image: 
        linear-gradient(to right, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent),
        linear-gradient(to bottom, transparent, black var(--fade-size), black calc(100% - var(--fade-size)), transparent);
    mask-composite: intersect; /* For other browsers */
    }
    body {
        /* Dark-mode fallback before a theme is applied */
        background-color: var(--bg);
        /* Add a smooth transition for theme changes */
        transition: background-color 0.4s ease-in-out;
    }

    body.light-mode {
        /* Light mode background */
        background-color: var(--bg);
    }

    #background-container {
        position: relative;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -10;
        background-color: var(--bg);

    }

    /* --- Robust Link Styling Override --- */
    /* This is a more specific rule to override Tufte CSS and fix the "mushed text" issue.*/
    .content-layer a {
        font-weight: 400;
        text-decoration: underline;
        text-decoration-color: var(--link-underline);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
        background: none !important;         /* CRITICAL: Disables Tufte's background/underline trick */
        text-shadow: none !important;
        /* CRITICAL: Disables Tufte's shadow effect */
        padding-bottom: 2px;
        transition: color 0.2s, text-decoration-color 0.2s;
    }
    .content-layer a[href]:hover,
    .content-layer a[href]:focus-visible {
        text-decoration-color: currentColor;
    }
    .content-layer a[href]:focus-visible {
        outline: 1px solid currentColor;
        outline-offset: 3px;
    }

      /* --- Link colors for DARK mode (Default) --- */
    .content-layer a {
        color: var(--link-color);
    }

      /* --- Link colors for LIGHT mode --- */
    .light-mode .content-layer a {
        color: var(--link-color);
    }

    .phd-button {
        /* Basic Button Styling */
        display: inline-block;
        padding: 12px 24px;
        margin-bottom: 20px;
        border-radius: 50px;
        text-decoration: none !important;
        font-weight: bold;
        font-size: 1.1em;
        text-align: center;
        /* Color and Hover Effects */
        background-color: #444444;
        color: #ffffff;
        border: 2px solid #707070;
        transition: all 0.3s ease;
    }
    html[data-theme="dark"] body {
      background-color: var(--bg);
      color: var(--text);
    }

    html[data-theme="dark"] h1,
    html[data-theme="dark"] h2,
    html[data-theme="dark"] h3 {
      color: var(--heading-color);
    }

    html[data-theme="dark"] #publications .pub-title {
      color: var(--heading-color);
    }

    html[data-theme="dark"] #publications .pub-venue {
      opacity: 1;
    }

    html[data-theme="light"] body {
      background-color: var(--bg);
      color: var(--text);
    }

    html[data-theme="light"] h1,
    html[data-theme="light"] h2,
    html[data-theme="light"] h3 {
      color: var(--heading-color);
    }

    html[data-theme="light"] .content-layer a {
      color: var(--link-color);
    }

            /* --- Theme Toggle Button --- */
    #theme-toggle {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100; /* Ensure it's on top of other content */
        background-color: #444;
        color: #fff;
        border: 1px solid #666;
        border-radius: 50%;
        width: 45px;
        height: 45px;
        font-size: 1.5rem;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

      #theme-toggle:hover {
        background-color: #555;
    }

    /* --- Light Mode Styles --- */
    body.light-mode {
        background-color: var(--bg);
        color: var(--text);
    }

    body.light-mode h1,
    body.light-mode h2,
    body.light-mode h3 {
        color: var(--heading-color);
    }
      
    body.light-mode .background-link {
        color: var(--link-color) !important;
    }

    body.light-mode hr, 
    body.light-mode blockquote {
        border-color: #dddddd;
    }

    body.light-mode .phd-button {
        background-color: #444444;
        color: #ffffff;
        border-color: #707070;
    }

    :where(h1,h2,h3,h4,h5,h6) {
        text-shadow: none !important;
        -webkit-text-stroke: 0 !important;
        filter: none !important;
        color: var(--heading-color);
    }

    /* 2) Prevent double underlines when a heading is a link */
    :where(h1,h2,h3,h4,h5,h6) a {
        color: inherit;
        text-decoration: none;         /* kill the link underline inside headings */
    }

    /* If you want an underline style for headings, do one consistent line: */
    :where(h1,h2,h3) {
        border-bottom: 2px solid var(--border);
        padding-bottom: .15rem;
    }

    /* 3) Safety reset in case a global text-shadow slipped in */
    :where(body, body *) {
        text-shadow: none;
    }

        /* Optional: nicer link underlines elsewhere */
    a {
        text-underline-offset: 0.05em;
        /* very close */
    }
    html {
        background-color: var(--bg);      /* fallback while the tile loads */
        background-attachment: scroll;    /* explicit: background moves with content */
        min-height: 100%;
    }

    @media (min-width: 769px) {
        body {
            width: 82.5%;
            max-width: 170ch;
        }
    }

    /* Small screens: pull the photo into the normal flow, centered, readable */
    @media (max-width: 768px) {
        body {
            width: 80%;
            padding: 1rem;
        }
        .marginnote, .sidenote {
            float: none;
            display: block;
            margin: 2rem 0 0;                  /* Aligns to the left with vertical spacing */
            width: 50% !important;           /* Force override of the inline 17% style */
            max-width: 200px;                /* Set a reasonable maximum size */
        }
        .profile-header {
            display: block;
            margin: 1rem 0 3rem;
        }
        .profile-header .profile-photo {
            margin: 0 0 2rem;
            width: 84% !important;
            max-width: 340px;
        }
        .intro-copy {
            width: 100%;
        }
        #publications .publication-entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 1rem;
            padding: 0.8rem 0;
        }
        #publications .publication-thumb {
            width: 50%;
            max-width: 200px;
        }
        #publications .pub-title {
            font-size: 1.35rem;
        }
        /* === PhD Student Group Mobile Layout: two per row === */
        .group-container {
            grid-template-columns: repeat(2, 117px);
            max-width: none;
            column-gap: 2.5rem;
            row-gap: 1.5rem;
        }
        #group .student-entry .pub-details p {
            white-space: nowrap;
        }
        #group .student-entry {
            width: 100%;
        }
        #group .student-entry figure {
            width: 100%;
        }
        #group .student-photo {
            width: 100% !important;
            height: auto !important;
            aspect-ratio: 6 / 7;
            object-fit: cover;
        }

    }

    /* === Contained layout: centred page column with section cards === */
    html {
        --outer-bg: #050505;
        --page-bg: #121212;
        --card-bg: #1a1a1a;
        --rule: #2e2e2e;
    }
    html[data-theme="light"] {
        --outer-bg: #e4e4e1;
        --page-bg: #ffffff;
        --card-bg: #f6f6f5;
        --rule: #e2e2e0;
    }
    html,
    html[data-theme] body,
    body.light-mode {
        background-color: var(--outer-bg);
    }
    body {
        width: auto;
        max-width: none;
        margin: 0;
        padding: 0;
    }
    main.content-layer {
        box-sizing: border-box;
        max-width: 1040px;
        min-height: 100vh;
        margin: 0 auto;
        padding: 1.75rem 1.5rem 0.5rem;
        background-color: var(--page-bg);
        box-shadow: 0 0 24px rgba(0, 0, 0, 0.08);
    }
    main.content-layer > section {
        width: auto;
    }
    .profile-header {
        margin-top: 0.5rem;
    }
    .intro-section {
        margin-bottom: 1.25rem;
    }
    #group,
    #publications {
        background-color: var(--card-bg);
        border-radius: 8px;
        padding: 1.25rem 1.6rem 1.4rem;
        margin: 0 0 1.25rem;
    }
    #group h2,
    #publications h2 {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 0 1.1rem;
        padding: 0;
        border: 0;
    }
    #group h2::after,
    #publications h2::after {
        content: "";
        flex: 1;
        height: 2px;
        background-color: var(--rule);
    }
    #publications .publication-thumb {
        background: var(--thumb-background);
    }
    .site-footer {
        margin: 1.5rem 0 0;
        padding: 1rem 0 1.25rem;
        border-top-color: var(--rule);
    }
    /* Header photo sized to match the height of the name/affiliation block */
    @media (min-width: 769px) {
        .profile-header {
            gap: 3rem;
            margin-bottom: 1rem;
        }
        .profile-header .profile-photo {
            flex: 0 0 340px;
            width: 340px;
        }
    }
    @media (max-width: 768px) {
        body {
            width: auto;
            padding: 0;
        }
        main.content-layer {
            padding: 1rem 1rem 0.5rem;
            box-shadow: none;
        }
        #group,
        #publications {
            padding: 1rem;
        }
    }
/* --- End of Styles --- */
    </style>
  </head>

  <body>
    <button id="theme-toggle" title="Toggle light/dark mode">☀️</button>
    <div id="background-container"></div>
    {# <article>
    </article> #}
    <main class="content-layer">
        {% block content %}{% endblock %}
    </main>
    <!--
    <script src="{{ '/background.js' | url }}" defer></script>-->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Logic to color main links
            const container = document.querySelector('.main-links');
            if (container) {
                const links = container.querySelectorAll('a');
                links.forEach(link => {
                    link.classList.add('background-link');
           
     });
            }

            // --- Theme Toggling Logic ---
            const themeToggle = document.getElementById('theme-toggle');
            const body = document.body;

            // Function to apply the chosen theme
            const applyTheme = (theme) => {
                if (theme === 'light') {
                    body.classList.add('light-mode');
                    document.documentElement.dataset.theme = 'light'; // [CORRECTED]
                    themeToggle.textContent = '🌙';
                } else {
                    body.classList.remove('light-mode');
                    document.documentElement.dataset.theme = 'dark';  // [CORRECTED]
                    themeToggle.textContent = '☀️';
                }
                // Redraw the canvas background with the new theme colors
                if (window.redrawBackground) {
                    window.redrawBackground();
                }
            };// Event listener for the toggle button
            themeToggle.addEventListener('click', () => {
                const newTheme = body.classList.contains('light-mode') ? 'dark' : 'light';
                localStorage.setItem('theme', newTheme);
                applyTheme(newTheme);
            });
            // Use the saved choice if there is one, otherwise follow the visitor's system setting
            const systemLight = window.matchMedia('(prefers-color-scheme: light)');
            const preferredTheme = () => localStorage.getItem('theme') || (systemLight.matches ? 'light' : 'dark');
            applyTheme(preferredTheme());
            systemLight.addEventListener('change', () => {
                if (!localStorage.getItem('theme')) applyTheme(preferredTheme());
            });

            const publicationVideos = document.querySelectorAll('.publication-video');
            const loadVideo = (video) => {
                if (video.dataset.loaded) return;
                const source = video.querySelector('source[data-src]');
                source.src = source.dataset.src;
                video.dataset.loaded = 'true';
                video.load();
            };

            if ('IntersectionObserver' in window) {
                const videoObserver = new IntersectionObserver((entries) => {
                    entries.forEach(({ target, isIntersecting }) => {
                        if (isIntersecting) {
                            loadVideo(target);
                            target.play().catch(() => {});
                        } else {
                            target.pause();
                        }
                    });
                }, { rootMargin: '200px 0px', threshold: 0.05 });

                publicationVideos.forEach(video => videoObserver.observe(video));
            } else {
                publicationVideos.forEach(video => loadVideo(video));
            }
        });
    </script>
</body>
</html>
