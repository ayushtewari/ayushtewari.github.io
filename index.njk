{% extends "base.njk" %}

{% block title %}
    Ayush Tewari
{% endblock %}

{% block content %}
    <section class="profile-header">
        <figure class="profile-photo">
            <img src="assets/ayush-tewari.jpg" width="1500" height="1000" alt="A photo of Ayush Tewari"/>
        </figure>
        <div class="profile-summary">
            <h1>Ayush Tewari</h1>
            <p class="subtitle">at2164@cam.ac.uk</p>
            <p class="profile-role">Assistant Professor, <a href="https://www.eng.cam.ac.uk/">Department of Engineering</a><br/><a href="https://www.cam.ac.uk/">University of Cambridge</a><br/>
            Fellow, <a href="https://www.joh.cam.ac.uk/">St John's College</a></p>
            <p class="profile-links">
                <a href="#group">Group</a> /
                <a href="#publications">Publications</a> /
                {{ metadata | safe }}
            </p>
        </div>
    </section>
    <section class="intro-section">
        <div class="intro-copy">
            <p>I work on visual perception and world modelling, studying how to turn observations into representations that support reconstruction, editing, reasoning, and planning. I was previously a postdoc at MIT CSAIL and completed my Ph.D. at the Max Planck Institute for Informatics.
</p>
            <p><a href="info/" class="phd-link">Information for prospective PhD students</a></p>
        </div>
    </section>

    <section id="group">
        <h2>PhD Students</h2>
        <div class="group-container">
            {% for member in group %}
            <div class="student-entry"> 
                <figure style="margin: 0;">
                    <img class="student-photo" src="{{ member.photo }}" alt="Photo of {{ member.name }}"/>
                </figure>
                <div class="pub-details">
                    <p style="margin: 0; font-size: 1.2rem;">
                        <b style="font-size: 1.4rem;">
                            {%- if member.url -%}
                            <a href="{{ member.url }}">{{ member.name }}</a>
                            {%- else -%}
                            {{ member.name }}
                            {%- endif -%}
                        </b>
                        {%- if member.role %}
                        <span class="student-role">{{ member.role }}</span>
                        {%- endif %}
                    </p>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>

    <section id="publications">
        <h2>Publications</h2>
        {% for pub in publications %}
        <div class="publication-entry">
            {% if pub.teaser %}
            <figure class="publication-thumb">
                {%- if pub.teaser | isAnimatedTeaser %}
                <video class="publication-video" loop muted playsinline preload="none" poster="{{ pub.teaser | teaserPoster }}" aria-label="Teaser for {{ pub.title }}">
                    <source data-src="{{ pub.teaser | teaserVideo }}" type="video/mp4" />
                </video>
                {%- else -%}
                <img src="{{ pub.teaser | teaserPoster }}" alt="Teaser for {{ pub.title }}" loading="lazy" decoding="async"/>
                {%- endif -%}
            </figure>
            {% endif %}
            <div class="pub-details">
                <h3 class="pub-title">{{ pub.title }}</h3>
                <p class="pub-authors">{{ pub.authors | safe }}</p>
                <p class="pub-venue">{{ pub.conference | safe }}</p>
                <div class="pub-links">{{ pub.data | safe }}</div>
            </div>
        </div>
        {% endfor %}
    </section>
    <!--section id="talks">
        <h2>Talks</h2>
        {% for talk in talks %}
        <p>
            <b>{{ talk.title }}</b>, <i>{{ talk.venue | safe}}</i>
            <span>{{ talk.data | safe }}</span>
        </p>
        {% endfor %}
    </section-->
    <footer class="site-footer">
        <p>Theme inspired and adapted from <a href="https://github.com/edwardtufte/tufte-css">tufte.css</a> and <a href="https://s-m.ac/">Mathias Sablé-Meyer</a>.</p>
    </footer>
{% endblock %}
